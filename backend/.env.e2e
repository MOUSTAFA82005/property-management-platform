# ---------------------------------------------------------------------------
# End-to-end test environment.
#
# This file exists so `php artisan migrate:fresh --seed --env=e2e` can never
# touch a developer's real database: it points at a throwaway SQLite file that
# is recreated from scratch before each E2E spec.
#
# The APP_KEY below is a fixed throwaway for tests only. It guards nothing —
# the database holds seeded demo data and nothing else.
# ---------------------------------------------------------------------------
APP_NAME=PropSpace
APP_ENV=e2e
APP_KEY=base64:0O8sQmHnWnq7l0pQZLp7T0S1nQq0mCJUxYr2eO5zHqk=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/e2e.sqlite

SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log

ALLOW_OWNER_REGISTRATION=false
